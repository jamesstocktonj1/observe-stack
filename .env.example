CLOUDFLARE_TUNNEL_TOKEN=<cloudflare tunnel token>

# Base directory for persistent data volumes (Prometheus, Grafana, Jaeger).
# Set to an absolute path on your long-term storage drive, e.g. /mnt/hdd/observe-stack
DATA_DIR=./data

# Password for the ClickHouse 'default' user (required for collector/Grafana
# to authenticate over the Docker network). Generate with: openssl rand -base64 24
CLICKHOUSE_PASSWORD=<clickhouse default user password>